from enum import Enum


class Immutability(str, Enum):
    RETENTION = "retention_daily"
    OBJECT_LOCK = "object_lock"
    NONE = "none"

    _ALIASES = {
        "retention_daily": "retention_daily",
        "retention_yearly": "retention_daily",
        "object_lock_daily": "object_lock",
        "object_lock_yearly": "object_lock",
    }

    @classmethod
    def _missing_(cls, value):
        if isinstance(value, str):
            canonical = cls._ALIASES.value.get(value.lower())
            if canonical is not None:
                return cls(canonical)
        return None
